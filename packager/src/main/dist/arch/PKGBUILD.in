# Generated by the JSoftSIP packager. Build with: makepkg -si
pkgname=jsoftsip
pkgver=@VERSION@
pkgrel=1
pkgdesc='Self-contained SIP softphone'
arch=('x86_64')
# The repository does not declare a public upstream URL; set one here when publishing this PKGBUILD.
url='https://github.com/'
license=('BSD-3-Clause')
depends=('alsa-lib' 'baresip' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'gtk3' 'libglvnd' 'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst')
options=('!strip')
source=("JSoftSIP-${pkgver}-linux-x64.tar.gz" 'jsoftsip.desktop')
sha256sums=('@ARCHIVE_SHA256@' '@DESKTOP_SHA256@')

package() {
    install -d -m 0755 "${pkgdir}/opt/JSoftSIP"
    cp -R "${srcdir}/JSoftSIP/bin" "${srcdir}/JSoftSIP/lib" "${pkgdir}/opt/JSoftSIP/"
    chmod -R a+rX,go-w "${pkgdir}/opt/JSoftSIP"

    install -d -m 0755 "${pkgdir}/usr/bin"
    ln -s /opt/JSoftSIP/bin/JSoftSIP "${pkgdir}/usr/bin/JSoftSIP"

    install -Dm644 "${srcdir}/jsoftsip.desktop" \
        "${pkgdir}/usr/share/applications/jsoftsip.desktop"
    install -Dm644 "${srcdir}/JSoftSIP/lib/JSoftSIP.png" \
        "${pkgdir}/usr/share/icons/hicolor/64x64/apps/jsoftsip.png"
    install -Dm644 "${srcdir}/JSoftSIP/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
