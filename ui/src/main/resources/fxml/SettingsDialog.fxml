<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jsoftsip.ui.controller.SettingsDialogController"
      spacing="10"
      prefWidth="560">

    <padding>
        <Insets top="15"
                right="15"
                bottom="15"
                left="15"/>
    </padding>

    <TabPane fx:id="tabPane"
             tabClosingPolicy="UNAVAILABLE"
             VBox.vgrow="ALWAYS">

        <Tab fx:id="tabGeneral"
             text="%settings.tab.general">
            <GridPane styleClass="settings-grid"
                      hgap="10"
                      vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT"
                                       fillWidth="false"/>
                </columnConstraints>

                <Label text="%settings.theme"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbTheme"
                          styleClass="settings-field"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="%language"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbLanguage"
                          styleClass="settings-field"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.window.geometry"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>
                <CheckBox fx:id="chkRememberWindowGeometry"
                          text="%settings.window.geometry.remember"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.exit.confirmation"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>
                <CheckBox fx:id="chkConfirmExitWithCalls"
                          text="%settings.exit.confirmation.confirm"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.baresip.logging"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>
                <CheckBox fx:id="chkSaveBaresipLogToFile"
                          text="%settings.baresip.logging.save"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.history"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="0"/>
                <Button fx:id="btnClearHistory"
                        prefWidth="70"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="1"/>

                <Label text="%settings.masterkey"
                        GridPane.rowIndex="6"
                        GridPane.columnIndex="0"/>
                <Button fx:id="btnRotateMasterKey"
                        prefWidth="70"
                        GridPane.rowIndex="6"
                        GridPane.columnIndex="1"/>
            </GridPane>
        </Tab>

        <Tab fx:id="tabAudio"
             text="%settings.tab.audio">
            <GridPane styleClass="settings-grid"
                      hgap="10"
                      vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT"
                                       fillWidth="false"/>
                </columnConstraints>

                <Label text="%settings.audio.output"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbAudioPlayer"
                          editable="true"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.audio.source"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbAudioSource"
                          editable="true"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.audio.alert"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbAudioAlert"
                          editable="true"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.audio.buffer"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>
                <TextField fx:id="txtAudioBuffer"
                           styleClass="settings-field"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

                <Label text="%settings.audio.buffer.mode"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbAudioBufferMode"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.audio.silence"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"/>
                <TextField fx:id="txtAudioSilence"
                           styleClass="settings-field"
                           GridPane.rowIndex="5"
                           GridPane.columnIndex="1"/>

                <Label text="%settings.jitter.buffer"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="0"/>
                <TextField fx:id="txtAudioJitterBufferMs"
                           styleClass="settings-field"
                           GridPane.rowIndex="6"
                           GridPane.columnIndex="1"/>

                <Label text="%settings.jitter.buffer.type"
                       GridPane.rowIndex="7"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbAudioJitterBufferType"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="7"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.jitter.buffer.size"
                       GridPane.rowIndex="8"
                       GridPane.columnIndex="0"/>
                <Spinner fx:id="spnAudioJitterBufferSize"
                         editable="true"
                         styleClass="settings-field"
                         GridPane.rowIndex="8"
                         GridPane.columnIndex="1"/>
            </GridPane>
        </Tab>

        <Tab fx:id="tabVideo"
             text="%settings.tab.video">
            <GridPane styleClass="settings-grid"
                      hgap="10"
                      vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT"
                                       fillWidth="false"/>
                </columnConstraints>

                <Label text="%settings.video.codec"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbVideoCodec"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.video.resolution"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbVideoResolution"
                          styleClass="settings-device-field"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="%settings.video.bitrate"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>
                <TextField fx:id="txtVideoBitrate"
                           styleClass="settings-field"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="%settings.video.fps"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>
                <Spinner fx:id="spnVideoFps"
                         editable="true"
                         styleClass="settings-field"
                         GridPane.rowIndex="3"
                         GridPane.columnIndex="1"/>
            </GridPane>
        </Tab>

        <Tab fx:id="tabBaresip"
             text="%settings.tab.baresip">
            <GridPane styleClass="settings-grid"
                      hgap="10"
                      vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT"
                                       fillWidth="false"/>
                </columnConstraints>

                <Label text="%settings.call.timeout"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>
                <Spinner fx:id="spnCallLocalTimeout"
                         editable="true"
                         styleClass="settings-field"
                         GridPane.rowIndex="0"
                         GridPane.columnIndex="1"/>

                <Label text="%settings.call.max"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>
                <Spinner fx:id="spnCallMaxCalls"
                         editable="true"
                         styleClass="settings-field"
                         GridPane.rowIndex="1"
                         GridPane.columnIndex="1"/>

                <Label text="%settings.rtp.timeout"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>
                <TextField fx:id="txtRtpTimeout"
                           styleClass="settings-field"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="%settings.registration.timeout"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>
                <Spinner fx:id="spnRegistrationTimeout"
                         editable="true"
                           styleClass="settings-field"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

                <Label text="%settings.call.accept"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>
                <CheckBox fx:id="chkCallAccept"
                          text="%settings.call.accept.auto"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="1"/>

                 <Label text="%settings.sip.listen"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="0"/>
                 <TextField fx:id="txtSipListen"
                            styleClass="settings-field"
                            GridPane.rowIndex="5"
                            GridPane.columnIndex="1"/>
             </GridPane>
         </Tab>

        <Tab fx:id="tabPreview"
              text="%settings.tab.baresip.config">
            <VBox spacing="5">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <TextArea fx:id="txtPreview"
                          editable="false"
                          prefRowCount="10"
                          styleClass="monospace-preview"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>

    </TabPane>

    <Label fx:id="lblError"
           visible="false"
           managed="false"
           wrapText="true"
           styleClass="danger"/>

    <HBox fx:id="busyBox"
          alignment="CENTER_LEFT"
          spacing="10"
          visible="false"
          managed="false">
        <ProgressIndicator prefWidth="24"
                           prefHeight="24"/>
        <Label text="%settings.restarting"/>
    </HBox>

    <HBox alignment="CENTER"
          spacing="10">

        <Button fx:id="btnApply"
                 prefWidth="70"/>

        <Button fx:id="btnClose"
                 prefWidth="70"/>

    </HBox>

</VBox>
