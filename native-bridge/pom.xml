<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jsoftsip</groupId>
        <artifactId>jsoftsip</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>native-bridge</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.jsoftsip</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Testing: compile-scope + optional so the module-info can
             declare requires static org.junit.jupiter.api, enabling test
             execution from both Maven and IntelliJ without leaking JUnit
             into production or native image builds (non-transitive). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JUnit is compile-scope on module path; tests run from
                         unnamed module. Allow unnamed module to read JUnit
                         modules and open internal packages used by the launcher. -->
                    <argLine>
                        --add-opens org.junit.platform.commons/org.junit.platform.commons.util=ALL-UNNAMED
                        --add-opens org.junit.platform.commons/org.junit.platform.commons.logging=ALL-UNNAMED
                    </argLine>
                    <!-- Live-baresip manual tests: they need a real baresip
                         process at 127.0.0.1:4444 and are excluded from the
                         default build so module-scoped mvn test stays green.
                         Run them manually with -Dtest when baresip is up.
                         BaresipSipClientTest keeps its live-baresip method
                         @Disabled so the FakeCtrlConnection unit tests run. -->
                    <excludes>
                        <exclude>**/BaresipCallIntegrationTest.java</exclude>
                        <exclude>**/CtrlTcpConnectionTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
